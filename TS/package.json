{
  "name": "t01",
  "version": "1.0.0",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "dev:nodemon": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",

    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",

    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",

    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build"
  },

  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "tsx": "^4.20.0",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.0"
  }
}